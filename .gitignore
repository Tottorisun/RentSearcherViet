__pycache__/
*.pyc
daily_check_logs/

# Per-session scratch files (fetched HTML, candidate JSON, one-off parsers)
# that daily-check sessions leave in the project root. Convention: anything
# starting with "_" is scratch and never committed. Nothing tracked starts
# with "_" (verified 2 Sep 2026).
_*

# Runtime state for the atomic listing-id allocator -- per-machine, must never
# be shared or committed: a stale ledger from another machine would hand out
# ids that are already used here.
.id_alloc.lock
.id_alloc.lock.stale.*
id_reservations.json

# Write lock around rebuild_final.py (listing_lock.py) and the temp file its
# atomic write goes through -- per-machine runtime state, never committed.
.listings_write.lock
.listings_write.lock.stale.*

# Замок вокруг суточного прогона (run_pipeline.py). Он существует только пока
# прогон идёт, но `git add -A` внутри самого прогона успевал его закоммитить, а
# конец прогона -- удалить: в истории появлялся файл, которого нет.
.pipeline.lock
rebuild_final.py.tmp*
*.html.tmp.*
posted_dates.json.tmp
liveness_cache.json.tmp
posted_to_telegram.json.tmp
posted_to_telegram.json.bak-*
posted_to_telegram_ph.json.tmp
posted_to_telegram_ph.json.bak-*

# Telegram ingestion / notification working state
telegram_candidates.json
posted_to_telegram.json
posted_to_telegram_ph.json
telegram_topics.json
telegram_topics_ph.json
# Временные файлы атомарной записи ingest_telegram.py (сами файлы -- в репозитории:
# состояние и выгрузка улиц нужны серверу между прогонами).
telegram_ingest_state.json.tmp
facebook_ingest_state.json.tmp
liveness_telegram_cache.json.tmp
osm_streets_da-nang.json.tmp

# Ad-hoc backups of scripts (run_daily_check.ps1.bak-..., etc) stay local.
*.bak-*

# A second scratch convention: daily-check sessions also write `scratch_*`
# (fetched pages, candidate dumps, one-off parsers) and the odd `retryN.html`.
# Only `_*` was covered before, so on 4 Sep 2026 a `git add -A` swept 180 of a
# concurrent session's working files into the index. Both conventions ignored now.
scratch_*
retry*.html

# Профиль браузера сборщика Facebook: живые cookies залогиненной сессии.
# Никогда не коммитить -- это доступ к аккаунту владельца.
_fb_profile/

# Скачанные фотографии Facebook-объявлений: их кладёт fb_collect.py.
# Рабочий каталог сборщика (fb_photos/ в корне) в репозиторий не идёт, а вот
# assets/fb_photos/ идёт обязательно: на эти файлы ссылаются строки сайта, и
# без них на GitHub Pages будут битые картинки. 12 сентября 2026 выяснилось,
# что правило накрывало и его: `git add` на исключённом пути падает целиком, и
# заведение постов Facebook с --commit не могло пройти вовсе -- ни фотографии,
# ни партия, ни rebuild_final.py. Двадцать каталогов уже лежали в репозитории
# только потому, что их когда-то добавили руками через -f.
fb_photos/
!assets/fb_photos/
