# Bash must see LF: with core.autocrlf=true a hook script checked out as
# CRLF breaks on the first `case`/`if` line ending in "\r".
*.sh text eol=lf
.claude/hooks/* text eol=lf
# Строки объявлений пишут и сервер, и ПК (core.autocrlf=true): без этого каждый
# переписывал бы переводы строк во всех файлах другого.
listings/**/*.jsonl text eol=lf
